# Cleaniq Nigeria API settings. Copy this file to server/.env and fill in real values there.
# server/.env is git-ignored — never commit it, never paste keys into chat.

# development | production | test
NODE_ENV=development
# Port the API listens on (the UK API uses a different one)
PORT=5050

# Our own Nigeria database on the VPS (MongoDB listens on 127.0.0.1 only). Never the UK database.
# Local development: mongodb://127.0.0.1:27017/cleaniq_ng
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/cleaniq_ng?authSource=admin

# Long random strings (at least 32 characters, different from each other).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=

# Website address (CORS + links in emails), e.g. https://cleaniq.ng  — locally http://localhost:5173
FRONTEND_URL=http://localhost:5173
# This API's public address, e.g. https://api.cleaniq.ng
PUBLIC_API_URL=http://localhost:5050

# Paystack (dashboard → Settings → API Keys & Webhooks). Use test keys until launch.
# Webhook URL to set in Paystack: <PUBLIC_API_URL>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# Public key is only used by the website, kept here so all keys live in one list
PAYSTACK_PUBLIC_KEY=

# Email (Resend). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Cleaniq Nigeria <bookings@cleaniq.ng>
# Where "new booking / new quote" alerts for the team go
TEAM_EMAIL=

# SMS (Termii)
TERMII_API_KEY=

# Claude — blog AI drafts / autopilot, later the AI receptionist
ANTHROPIC_API_KEY=

# Used once by `npm run seed` to create the first owner admin (remove after seeding)
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Backups (scripts/backup-db.js): where copies go off the VPS. See scripts/README-backups.md
BACKUP_DIR=/var/backups/cleaniq_ng
BACKUP_KEEP=14
# Command run with the backup file path appended, e.g. "rclone copy" target, or leave empty
BACKUP_UPLOAD_CMD=
