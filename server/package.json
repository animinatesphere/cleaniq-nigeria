{
  "name": "cleaniq-nigeria-server",
  "version": "1.0.0",
  "private": true,
  "description": "Cleaniq Nigeria API — bookings, quotes, blog, Paystack payments",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "backup": "node --env-file-if-exists=.env scripts/backup-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24"
    }
  }
}
